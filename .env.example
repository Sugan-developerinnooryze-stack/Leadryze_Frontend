VITE_API_URL=http://localhost:5000
VITE_AI_URL=http://localhost:5001
VITE_APP_NAME=LeadRyze AI
VITE_APP_VERSION=1.0.0

# Full URL to the deployed widget's loader.js (leadryze-widget, its own Render
# Static Site). Optional — falls back to `${VITE_API_URL}/widget/loader.js`
# (the backend's own static-serve fallback) if unset, which is fine for local
# dev. In production, set this to the widget's real deployed URL, e.g.:
# VITE_WIDGET_SCRIPT_URL=https://leadryze-widget.onrender.com/loader.js
VITE_WIDGET_SCRIPT_URL=
